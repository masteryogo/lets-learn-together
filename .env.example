# Credenciais do Supabase, lidas no build (SvelteKit expõe só o prefixo PUBLIC_).
# A chave publicável ("anon") é feita para viajar no navegador: quem protege os
# dados é a RLS do banco. A service_role NUNCA entra aqui.
PUBLIC_SUPABASE_URL=https://atmotqhqvhfaeoirdnzo.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Endereço público do aplicativo. Sem ele, a landing abre /app, útil no
# desenvolvimento local; em produção, aponte para o subdomínio do LLT.
# Exemplo: https://app.seudominio.com
PUBLIC_APP_URL=
